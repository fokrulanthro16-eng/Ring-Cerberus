# ==============================================================================
# Ring Cerberus - Autonomous Defensive Swarm & Zero-Trust Perimeter Lockdown
# Environment Configuration Template
# ==============================================================================

# AWS Bedrock & Polly Settings (Leave empty or MOCK_AWS=true for local simulation mode)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
MOCK_AWS=true

# Bedrock Model Identifiers
BEDROCK_VISION_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_INTERROGATOR_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0

# Amazon Polly Voice Configuration
POLLY_VOICE_ID=Brian
POLLY_ENGINE=neural

# Security & Airlock TOTP Secrets
AIRLOCK_SECRET_SEED=CERBERUS_DEFENSE_TOP_SECRET_AIRLOCK_2026
LOCKDOWN_PIN=9941

# Server & Network Ports
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Next.js Public Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
